# Salad.com training and generation image
# Built from project root: docker build -f docker/training/Dockerfile.salad -t spinlock:salad .

FROM spinlock:base

# Install AWS CLI for S3 uploads (needed for generation jobs)
RUN apt-get update && apt-get install -y \
    awscli \
    && rm -rf /var/lib/apt/lists/*

# Copy application code
COPY src/ ./src/
COPY configs/ ./configs/
COPY pyproject.toml poetry.lock README.md ./

# Install the spinlock package
RUN poetry install --only-root --no-interaction --no-ansi

# Add cloud storage helper scripts
COPY docker/training/entrypoint-salad.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Create directories for datasets and checkpoints
RUN mkdir -p /app/datasets /app/checkpoints

# Entry point handles data sync + training
ENTRYPOINT ["/entrypoint.sh"]
CMD ["train-meta-operator", "--help"]
