# Spinlock Environment Variables
# Copy this file to .env and fill in your credentials
# DO NOT commit .env to version control

# Lambda Labs GPU Cloud API Key
# Used for cloud dataset generation on Lambda Labs instances
# Get your API key from: https://cloud.lambdalabs.com/api-keys
LAMBDA_API_KEY=your-lambda-api-key-here

# Salad.com API credentials
# Get your API key from: https://portal.salad.com/
SALAD_API_KEY=your-salad-api-key-here

# Docker Hub credentials (for Salad container registry)
DOCKER_USERNAME=your-dockerhub-username
DOCKER_PASSWORD=your-dockerhub-password
DOCKER_REGISTRY=your-dockerhub-username

# MinIO storage (local, exposed via UPnP)
# These are set automatically by setup-minio-port-forward.sh
MINIO_ENDPOINT=http://YOUR_PUBLIC_IP:9000
MINIO_ACCESS_KEY=generate-with-openssl-rand
MINIO_SECRET_KEY=generate-with-openssl-rand

# AWS S3 Credentials (optional - for S3 storage instead of MinIO)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_DEFAULT_REGION=us-west-2

# Redis for coordination (optional - only needed for multi-node Salad deployments)
# REDIS_URL=redis://user:password@host:6379/0
